# Public RevenueCat Android SDK key (safe to include at build time)
VITE_REVENUECAT_ANDROID_API_KEY=goog_your_public_android_sdk_key
# Public Google Web OAuth client ID used by Android Credential Manager to request an ID token.
VITE_GOOGLE_WEB_CLIENT_ID=123456789-example.apps.googleusercontent.com
# Google demo rewarded unit for local/test builds only.
VITE_ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
# Android manifest App ID is injected by scripts/patch-android-admob.mjs in CI.
# Production CI secret name: ADMOB_ANDROID_APP_ID
